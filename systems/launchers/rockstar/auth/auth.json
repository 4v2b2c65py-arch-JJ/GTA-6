{
  "id": "rockstar_auth",
  "type": "auth_config",
  "version": "1.0.0",
  "provider": "rockstar_games_account",
  "status": "active",
  "flows": {
    "login": {
      "enabled": true,
      "fields": ["email", "password", "remember_me"],
      "optional": ["two_step_code"],
      "requires_network": true,
      "session_ref": "systems/launchers/rockstar/auth/session.json",
      "on_success": ["set_session_active", "load_library", "sync_cloud_saves_model"]
    },
    "signup": {
      "enabled": true,
      "fields": ["email", "password", "confirm_password", "dob", "country", "display_name", "accept_terms"],
      "requires_network": true,
      "verification": { "email_verification_required": true, "two_step_setup_recommended": true },
      "accounts_ref": "systems/launchers/rockstar/auth/accounts.json",
      "on_success": ["create_account", "set_session_active", "prompt_email_verification"]
    },
    "logout": {
      "enabled": true,
      "on_success": ["clear_session", "return_to_login"]
    }
  },
  "security": {
    "two_step_verification": "supported",
    "password_policy": { "min_length": 8, "recommend_unique": true },
    "single_active_session_per_account": true
  },
  "account_linking": {
    "supported": ["steam", "epic", "xbox", "playstation"],
    "rules": {
      "steam": "one_rockstar_account_per_steam_account",
      "epic": "one_rockstar_account_per_epic_account"
    }
  },
  "refs": {
    "accounts": "systems/launchers/rockstar/auth/accounts.json",
    "session": "systems/launchers/rockstar/auth/session.json"
  }
}
