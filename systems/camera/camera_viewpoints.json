{
  "id": "camera_viewpoints",
  "type": "camera_config",
  "version": "1.1.0",
  "render_pipeline": "depth_pixel_partition",
  "camera_categories": {
    "visible": {
      "description": "Renderable cameras exposed to player/viewport outputs.",
      "render_to_viewport": true,
      "ai_core_feed": true
    },
    "invisible": {
      "description": "Non-rendered analytic/sensor cameras feeding map AI core without viewport draw.",
      "render_to_viewport": false,
      "ai_core_feed": true
    }
  },
  "ai_core": {
    "enabled": true,
    "map_core_ref": "home_world/mind_core/mind_aspect_map.json",
    "spawn_views": {
      "enabled": true,
      "allow_runtime_spawn": true,
      "max_views_per_load": 64,
      "default_spawn_category": "invisible",
      "spawn_targets": ["map_partition", "zone", "poi", "device_fpv", "terrain_slice"]
    },
    "clearance": {
      "profile": "earth_level",
      "single_load": true,
      "coverage": "full_map",
      "fidelity_tier": "reality_plus_clearview",
      "reference_baseline": "unity_level_clearview",
      "quality_target": "above_unity_level_clearview_at_reality_parity",
      "depth_precision": "subpixel",
      "partition_sync": "atomic_single_load"
    }
  },
  "cameras": [
    {
      "camera_id": "cam-overview",
      "name": "Overview Strategic",
      "category": "visible",
      "visibility": "visible",
      "spawnable": false,
      "type": "perspective",
      "mode": "orbit",
      "position": { "x": 0, "y": 18, "z": 22 },
      "target": { "x": 0, "y": 1, "z": 0 },
      "up": { "x": 0, "y": 1, "z": 0 },
      "fov_deg": 60,
      "near": 0.1,
      "far": 120,
      "viewport": { "w": 1920, "h": 1080 },
      "purpose": "full_map_partition_overview",
      "active": true
    },
    {
      "camera_id": "cam-topdown",
      "name": "Top-Down Atlas",
      "category": "visible",
      "visibility": "visible",
      "spawnable": false,
      "type": "orthographic",
      "mode": "fixed",
      "position": { "x": 0, "y": 30, "z": 0.01 },
      "target": { "x": 0, "y": 0, "z": 0 },
      "up": { "x": 0, "y": 0, "z": -1 },
      "ortho_size": { "width": 110, "height": 110 },
      "near": 0.1,
      "far": 150,
      "viewport": { "w": 2048, "h": 2048 },
      "purpose": "partition_index_and_depth_atlas",
      "active": true
    },
    {
      "camera_id": "cam-fpv-main",
      "name": "FPV Main (Scout)",
      "category": "visible",
      "visibility": "visible",
      "spawnable": false,
      "type": "perspective",
      "mode": "fpv_device",
      "device_binding": { "fpv_id": "fpv-main", "device_id": "dev-fpv-cam-001", "model": "SCOUT-CAM-M1" },
      "position": { "x": -2, "y": 2.2, "z": 8 },
      "target": { "x": 0, "y": 1.5, "z": 0 },
      "fov_deg": 85,
      "near": 0.05,
      "far": 80,
      "viewport": { "w": 1280, "h": 720 },
      "purpose": "player_fpv_depth",
      "active": true
    },
    {
      "camera_id": "cam-fpv-relay",
      "name": "FPV Relay (Back)",
      "category": "visible",
      "visibility": "visible",
      "spawnable": false,
      "type": "perspective",
      "mode": "fpv_device",
      "device_binding": { "fpv_id": "fpv-relay", "device_id": "dev-fpv-cam-002", "model": "RELAY-CAM-M1" },
      "position": { "x": 4, "y": 2.8, "z": 10 },
      "target": { "x": 0, "y": 1.2, "z": 2 },
      "fov_deg": 78,
      "near": 0.05,
      "far": 90,
      "viewport": { "w": 1280, "h": 720 },
      "purpose": "relay_fpv_depth",
      "active": true
    },
    {
      "camera_id": "cam-cant-plates",
      "name": "Cant Plates Pressure",
      "category": "visible",
      "visibility": "visible",
      "spawnable": false,
      "type": "perspective",
      "mode": "cinematic_fixed",
      "position": { "x": -10, "y": 6, "z": 6 },
      "target": { "x": -2, "y": 1.2, "z": -2 },
      "fov_deg": 50,
      "near": 0.1,
      "far": 100,
      "viewport": { "w": 1600, "h": 900 },
      "focus_zone": "Z3-cant-plates",
      "purpose": "pressure_region_depth_layers",
      "active": true
    },
    {
      "camera_id": "cam-crest-reveal",
      "name": "Crest Reveal",
      "category": "visible",
      "visibility": "visible",
      "spawnable": false,
      "type": "perspective",
      "mode": "cinematic_fixed",
      "position": { "x": 8, "y": 5, "z": -8 },
      "target": { "x": 3, "y": 2, "z": -2 },
      "fov_deg": 45,
      "near": 0.1,
      "far": 100,
      "viewport": { "w": 1600, "h": 900 },
      "focus_zone": "Z4-crest-reveal",
      "purpose": "reveal_region_depth_layers",
      "active": true
    },
    {
      "camera_id": "cam-ai-earth-clearance",
      "name": "AI Earth Clearance Scan",
      "category": "invisible",
      "visibility": "invisible",
      "spawnable": true,
      "type": "orthographic",
      "mode": "ai_core_scan",
      "position": { "x": 0, "y": 120, "z": 0.01 },
      "target": { "x": 0, "y": 0, "z": 0 },
      "up": { "x": 0, "y": 0, "z": -1 },
      "ortho_size": { "width": 120, "height": 120 },
      "near": 0.01,
      "far": 500,
      "viewport": { "w": 4096, "h": 4096 },
      "purpose": "earth_level_full_map_single_load_clearance",
      "clearance_profile": "earth_level",
      "fidelity_tier": "reality_plus_clearview",
      "active": true
    },
    {
      "camera_id": "cam-ai-depth-probe",
      "name": "AI Depth Probe",
      "category": "invisible",
      "visibility": "invisible",
      "spawnable": true,
      "type": "perspective",
      "mode": "ai_core_probe",
      "position": { "x": 0, "y": 10, "z": 18 },
      "target": { "x": 0, "y": 1, "z": 0 },
      "fov_deg": 70,
      "near": 0.01,
      "far": 200,
      "viewport": { "w": 2048, "h": 2048 },
      "purpose": "subpixel_depth_partition_analysis",
      "fidelity_tier": "reality_plus_clearview",
      "active": true
    },
    {
      "camera_id": "cam-ai-sector-Z3",
      "name": "AI Sector Scan Z3",
      "category": "invisible",
      "visibility": "invisible",
      "spawnable": true,
      "type": "perspective",
      "mode": "ai_core_sector",
      "position": { "x": -12, "y": 14, "z": 4 },
      "target": { "x": -2, "y": 1.2, "z": -2 },
      "fov_deg": 55,
      "near": 0.01,
      "far": 180,
      "viewport": { "w": 2048, "h": 2048 },
      "focus_zone": "Z3-cant-plates",
      "purpose": "sector_depth_clearance_spawn_view",
      "fidelity_tier": "reality_plus_clearview",
      "active": true
    }
  ],
  "depth_partition": {
    "enabled": true,
    "method": "pixel_depth_bucket",
    "space": "view_space_linear",
    "near_plane": 0.05,
    "far_plane": 120,
    "partition_count": 6,
    "layers": [
      { "layer_id": "DP-0", "name": "foreground", "depth_min": 0, "depth_max": 0.12, "zone_bias": ["Z0-core-plate"], "priority": 100 },
      { "layer_id": "DP-1", "name": "near", "depth_min": 0.12, "depth_max": 0.28, "zone_bias": ["Z1-fault-belt", "Z2-traction-run"], "priority": 90 },
      { "layer_id": "DP-2", "name": "mid_near", "depth_min": 0.28, "depth_max": 0.45, "zone_bias": ["Z2-traction-run", "Z3-cant-plates"], "priority": 80 },
      { "layer_id": "DP-3", "name": "mid_far", "depth_min": 0.45, "depth_max": 0.65, "zone_bias": ["Z3-cant-plates", "Z4-crest-reveal"], "priority": 70 },
      { "layer_id": "DP-4", "name": "far", "depth_min": 0.65, "depth_max": 0.85, "zone_bias": ["Z4-crest-reveal", "Z5-settled-path"], "priority": 60 },
      { "layer_id": "DP-5", "name": "background", "depth_min": 0.85, "depth_max": 1, "zone_bias": ["Z5-settled-path"], "priority": 50 }
    ],
    "output": {
      "per_camera_layers": true,
      "region_partition_map": "home_world/bodium_terrain/render/map_partitions_by_depth.json"
    }
  },
  "refs": {
    "terrain": "home_world/bodium_terrain/bodium_terrain_map.json",
    "scenery": "home_world/bodium_terrain/scenery_compute.json",
    "grid_store": "systems/grid_store/qbit_zone_pocket_map.json",
    "fpv_devices": "systems/fpv/game_fpv_devices.json",
    "ai_core": "home_world/mind_core/mind_aspect_map.json"
  }
}
